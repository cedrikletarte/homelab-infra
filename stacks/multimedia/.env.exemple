# -- Domain --
# Root domain used to generate the Traefik URL for Seerr (seerr.${PRIMARY_DOMAIN})
PRIMARY_DOMAIN=

# -- Plex --
# One-time Plex claim token (valid for 4 minutes), get one at https://plex.tv/claim
PLEX_CLAIM=
# Host UID used by the Plex container for file permissions
PLEX_UID=
# Host GID used by the Plex container for file permissions
PLEX_GID=

# -- gluetun --
# VPN provider username (e.g. dedicated PIA account used for port forwarding)
OPENVPN_USER=
# VPN provider password matching the username above
OPENVPN_PASSWORD=
# VPN provider server name (e.g. toronto420 for PIA, check gluetun logs for the correct server name)
SERVER_NAMES=

# -- multimedia --
# Host UID used by the *arr apps/qBittorrent for permissions on media files
MULTIMEDIA_UID=
# Host GID used by the *arr apps/qBittorrent for permissions on media files
MULTIMEDIA_GID=
# Host path to the shared media storage (mounted as /data in the containers)
MEDIA_PATH=
# Timezone used by the containers in the stack
TZ=
