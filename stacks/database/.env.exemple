# -- Postgres --
# Admin superuser, created on first startup. Only for administration: no app connects with it
POSTGRES_USER=postgres
# Password for the admin superuser above
POSTGRES_PASSWORD=
# Database created on first startup (the apps' databases are created by hand, see README.md)
POSTGRES_DB=postgres

# -- Accounts created by hand (see README.md), kept here for reference --
# homelab_writer: the n8n workflows write to homelab.homelab_alerts with it (n8n credential "Postgres account")
HOMELAB_WRITER_PASSWORD=

# -- Host --
# Server LAN address: the ports published to the LAN only bind to it (not to every interface)
LAN_IP=192.168.1.10
