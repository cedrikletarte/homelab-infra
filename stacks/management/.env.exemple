# -- Domain --
# Root domain used to generate Traefik URLs (vaultwarden, n8n, etc.)
PRIMARY_DOMAIN=

# -- Homarr --
# Encryption key used by Homarr to encrypt stored secrets (generate with `openssl rand -hex 32`)
HOMARR_SECRET_ENCRYPTION_KEY=

# -- N8N --
# Name of the Postgres database used by n8n
POSTGRES_DATABASE=
# Host/address of the Postgres server (service or container name, e.g. postgres)
POSTGRES_HOST=
# Port the Postgres server listens on
POSTGRES_PORT=
# Postgres user n8n connects with
POSTGRES_USER=
# Postgres schema used by n8n (defaults to "public")
POSTGRES_SCHEMA=
# Password for the Postgres user above
POSTGRES_PASSWORD=
# Full public URL used by n8n to generate its links (webhooks, editor, etc.)
N8N_EDITOR_BASE_URL=

# Timezone used by the containers in the stack
TZ=
