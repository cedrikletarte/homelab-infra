# Server LAN address: Grafana is published there only (admin tool, ADR 0002)
LAN_IP=192.168.1.10
TZ=America/Toronto

# Read-only account on homelab.homelab_alerts, used by the dashboards and alert rules
HOMELAB_ALERTS_READER_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Discord webhook for Grafana alerts
DISCORD_WEBHOOK_URL=
