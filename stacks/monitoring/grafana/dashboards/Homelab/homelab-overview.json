    {
      "id": 7,
      "type": "timeseries",
      "title": "Problems per day, by source",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homelab-alerts"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homelab-alerts"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d', 0), source AS metric, count(*) AS value\nFROM homelab_alerts\nWHERE $__timeFilter(created_at) AND status IN ('error', 'alert', 'failed')\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "description": "Every report that was not ok, per source.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          },
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "interval": "1d",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Deploy runs per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homelab-alerts"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homelab-alerts"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d', 0),\n  CASE WHEN status <> 'ok' THEN 'error'\n       WHEN message LIKE '%Recreated containers%' THEN 'deployed'\n       ELSE 'nothing to deploy' END AS metric,\n  count(*) AS value\nFROM homelab_alerts\nWHERE $__timeFilter(created_at) AND source = 'docker_pull_and_run'\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "description": "docker_pull_and_run runs: deployed (containers recreated), nothing to deploy, or error.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          },
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "interval": "1d",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CrowdSec alerts per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homelab-alerts"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homelab-alerts"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d', 0), 'alerts' AS metric, count(*) AS value\nFROM homelab_alerts\nWHERE $__timeFilter(created_at) AND source = 'crowdsec'\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "description": "CrowdSec alert notifications (each one batches up to 10 alerts).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          },
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "interval": "1d",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Merge requests opened per week",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homelab-alerts"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homelab-alerts"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '7d', 0), 'opened' AS metric, count(*) AS value\nFROM homelab_alerts\nWHERE $__timeFilter(created_at) AND source = 'gitlab_merge_request'\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "description": "Only openings are recorded: merges are not reported to the table.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          },
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "interval": "7d",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Pipelines per week",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homelab-alerts"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homelab-alerts"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '7d', 0), status AS metric, count(*) AS value\nFROM homelab_alerts\nWHERE $__timeFilter(created_at) AND source = 'gitlab_pipeline'\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "description": "Finished GitLab pipelines of the projects whose webhook sends pipeline events.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          },
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "interval": "7d",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Latest reports",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "homelab-alerts"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homelab-alerts"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT created_at AS \"Time\", source AS \"Source\", status AS \"Status\",\n  split_part(message, E'\\n', 1) AS \"Message\"\nFROM homelab_alerts\nWHERE $__timeFilter(created_at)\nORDER BY created_at DESC\nLIMIT 200"
        }
      ],
      "description": "Newest first. The full message and logs are in the homelab_alerts table.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green"
                      },
                      "success": {
                        "color": "green"
                      },
                      "opened": {
                        "color": "blue"
                      },
                      "warning": {
                        "color": "orange"
                      },
                      "repaired": {
                        "color": "orange"
                      },
                      "alert": {
                        "color": "red"
                      },
                      "error": {
                        "color": "red"
                      },
                      "failed": {
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Source"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ],
  "description": "Reports sent to n8n by the maintenance scripts, CrowdSec and GitLab, read from homelab_alerts."
}