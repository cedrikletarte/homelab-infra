      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "homelab-alerts"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) FROM homelab_alerts WHERE $__timeFilter(created_at) AND status IN ('error', 'alert', 'failed')"
        }
