# Managed by Ansible (maintenance role). Each script is described in scripts/<name>/README.md.
# Output goes to the journal, one tag per script: journalctl -t <tag>
# m h dom mon dow user command
0 2 * * * root {{ repo_dir }}/scripts/disk-health-check/disk_health_check.sh 2>&1 | systemd-cat -t disk_health_check
0 2 * * * root {{ repo_dir }}/scripts/docker-pull-and-run/docker_pull_and_run.sh 2>&1 | systemd-cat -t docker_pull_and_run
0 3 * * 0 root {{ repo_dir }}/scripts/docker-backup/docker_backup.sh 2>&1 | systemd-cat -t docker_backup
*/5 * * * * root {{ repo_dir }}/scripts/docker-unhealthy-monitor/docker_unhealthy_monitor.sh 2>&1 | systemd-cat -t docker_unhealthy_monitor
*/5 * * * * root {{ repo_dir }}/scripts/gluetun-watchdog/gluetun_watchdog.sh 2>&1 | systemd-cat -t gluetun_watchdog
