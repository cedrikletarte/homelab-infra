# -- Cloudflare & Traefik --
# Cloudflare API token (DNS:Edit permission) used by cloudflare-ddns and Traefik (Let's Encrypt DNS-01 challenge)
API_KEY=
# Root domain name managed on Cloudflare (DNS zone)
ZONE=
# Cloudflare Tunnel token (Zero Trust > Tunnels) used to expose services without opening ports
TUNNEL_TOKEN=
# Subdomain dynamically updated by cloudflare-ddns (e.g. vpn.example.com)
SUBDOMAIN=

# -- WireGuard --
# Internal subnet assigned to clients connected to the WireGuard VPN
INTERNAL_SUBNET=
# UID the WireGuard process runs as inside the container (should match a host user)
WIREGUARD_PUID=
# GID the WireGuard process runs as inside the container (should match a host group)
WIREGUARD_PGID=

# -- Crowdsec --
# GID the Crowdsec process runs as inside the container (often the "adm" group, needed to read /var/log)
CROWDSEC_PGID=
# Timezone used by all containers in the stack
TZ=
