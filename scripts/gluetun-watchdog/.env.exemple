# -- Notifications --
# n8n webhook endpoint used for Discord notifications + PostgreSQL log
WEBHOOK_URL=

# -- Instances --
# Space-separated "container:pia_region" pairs (regions: pia_wireguard.sh regions)
GLUETUN_INSTANCES="gluetun:ca_toronto"

# -- Thresholds --
# Minutes a gluetun container must stay unhealthy before regenerating
UNHEALTHY_MINUTES=15
# Minimum minutes between two regenerations of the same container
COOLDOWN_MINUTES=60
# Seconds to wait for gluetun to become healthy after recreation
HEALTHY_TIMEOUT=180
