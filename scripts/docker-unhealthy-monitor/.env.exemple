# -- Notifications --
# n8n webhook endpoint used for Discord notifications + PostgreSQL log, with the credentials of its
# Basic Auth: http://<user>:<password>@localhost:5678/webhook/<path>
WEBHOOK_URL=

# -- Exclusions --
# Space-separated container names to skip (gluetun is handled by gluetun_watchdog.sh)
IGNORE_CONTAINERS="gluetun searxng-gluetun"

# -- Optional (defaults shown) --
# A container still failing is reported (and restarted) again after this many minutes
# COOLDOWN_MINUTES=60
# Directory holding one timestamp per reported container
# STATE_DIR=/var/tmp/docker-unhealthy-monitor
