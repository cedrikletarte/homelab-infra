# -- Notifications --
# n8n webhook endpoint used for Discord notifications + PostgreSQL log
WEBHOOK_URL=

# -- Paths --
# Root folder containing the stack subdirectories to scan
HOMELAB_STACKS=

# -- Exclusions --
# Space-separated container names to skip (gluetun is handled by gluetun_watchdog.sh)
IGNORE_CONTAINERS="gluetun searxng-gluetun"
