# -- Notifications --
# n8n webhook endpoint used for Discord notifications + PostgreSQL log
WEBHOOK_URL=

# -- Optional (defaults shown) --
# A deploy only runs if docker_backup.sh succeeded within this many hours (use --force to bypass)
# BACKUP_MAX_AGE_HOURS=180
# File written by docker_backup.sh on success (must match the backup script's BACKUP_MARKER)
# BACKUP_MARKER=/var/lib/docker-backup/last_success
# Stack directories never applied, space-separated (Nextcloud AIO updates itself from its own interface)
# SKIP_STACKS=nextcloud
# A failed `docker compose up -d` (for example a registry rate limit) is retried this many times, with this pause in seconds
# PULL_ATTEMPTS=3
# PULL_RETRY_WAIT=60
# Remote and branch the clone is fast-forwarded to
# GIT_REMOTE=origin
# GIT_BRANCH=main
