# -- Notifications --
# n8n webhook endpoint used for Discord notifications + PostgreSQL log
WEBHOOK_URL=

# -- Paths --
# Root of the homelab-infra repo (stacks are stopped/restarted from here)
HOMELAB_DIR=
# Local temp folder for the volumes archive before upload
BACKUP_TMP=
# Docker volumes folder to archive
DOCKER_VOLUMES_DIR=
# Immich data
IMMICH_DIR=
# Nextcloud data
NEXTCLOUD_DIR=

# -- Rclone --
# rclone remote to upload to (crypt remote wrapping OneDrive, see README)
ONEDRIVE_BASE=
# Path to the rclone.conf used
RCLONE_CONFIG=
